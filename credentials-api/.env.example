PORT=3000
PUBLIC_BASE_URL=https://localhost:3000
ISSUER_NAME=Fieldnote Learning
ADMIN_API_TOKEN=replace-with-a-long-random-token
ISSUER_PRIVATE_JWK_B64=generated-by-npm-run-keys
ISSUER_PUBLIC_JWK_B64=generated-by-npm-run-keys
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Put a locally trusted PKCS#12 certificate at this path for direct HTTPS.
TLS_PFX_PATH=data/fieldnote-localhost.pfx
TLS_PFX_PASSPHRASE=set-locally
# Set true only when a trusted HTTPS reverse proxy overwrites X-Forwarded-Proto.
TRUST_PROXY=false